# Copy to .env and fill in locally. NEVER commit .env (it is gitignored).
# Placeholders only: values must stay empty in this file (enforced by tests/test_smoke.py), except URLs.
#
# PROVISIONAL: the hackathon kit ships its own env.example with two keys (your Freya API key and a
# team key you make up for the practice bank). When the kit arrives, replace these names with the kit's.
# FREYA_API_KEY follows the naming in Freya's Embed SDK example (docs.freyavoice.ai/guides/embed/overview).

# Workspace API key: Dashboard -> Settings -> API Keys -> Create API Key (shown only once).
# Sent as "Authorization: Bearer <key>". Keys expire (default 90 days).
FREYA_API_KEY=

# Platform REST API base URL (the only `servers` entry in https://app.freyavoice.ai/api/openapi.json).
FREYA_API_BASE_URL=https://app.freyavoice.ai/api/v2

# Workspace UUID. Many endpoints require workspaceId; GET /api-keys/check returns it for a key.
FREYA_WORKSPACE_ID=
