# Copy to .env, fill in locally, then:  source .env
# NEVER commit .env (it is gitignored). Values here must stay empty except URLs (tests/test_smoke.py).
# Names follow the official kit's env.example (kit/env.example).

# Workspace API key (starts with fak_): Freya dashboard -> Developers -> API Keys.
export FREYA_API_KEY=

# Freya API host used by kit/freya.py (paths add /api/v2/...). The event runs on staging.
export FREYA_API_URL=https://staging-app.freyavoice.ai

# Practice-bank team key: any secret of 16+ characters you make up. Use the same one every time.
export FREYA_BANK_TEAM_KEY=

# Optional: kit/freya.py otherwise takes the first workspace the key can see.
export FREYA_WORKSPACE_ID=

# Builder LLM (OpenAI). Only the builder uses it; the phone agent runs on Freya's fixed model.
export OPENAI_API_KEY=
# Optional. Tried before the built-in chain gpt-6.1-sol, gpt-5.5, gpt-5.4 (llm.DEFAULT_MODELS).
export BUILDER_MODEL=
export BUILDER_MODEL_FALLBACKS=
