# --- Secrets & credentials (never commit) ---
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets/
credentials/
*credentials*.json
*secret*.json
*token*.json

# --- Python ---
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# --- Run artefacts (evaluation outputs, transcripts, logs) ---
# Keep generated outputs out of git by default; commit curated results deliberately.
runs/
logs/
*.log

# --- Editors / OS ---
.DS_Store
.idea/
.vscode/
*.swp

# --- Claude Code local settings ---
.claude/settings.local.json
