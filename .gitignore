# --- Secrets & credentials (never commit) ---
.env
.env.*
!.env.example
env.sh
**/env.sh
.freya-agents.json
**/.freya-agents.json
*.pem
*.key
*.p12
*.pfx
secrets/
credentials/
*credentials*.json
*secret*.json
*token*.json

# --- Python ---
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# --- Run artefacts (evaluation outputs, transcripts, logs) ---
# Keep generated outputs out of git by default; commit curated results deliberately.
runs/
logs/
# Generated by kit/tools/run_cases.py (persona-id cache, per-run results)
kit/.personas.json
kit/results/
*.log
# ...except the builder traces we must submit (traces/hidden-N.log) — keys stripped before commit.
!traces/*.log

# --- Editors / OS ---
.DS_Store
.idea/
.vscode/
*.swp

# --- Claude Code local settings ---
.claude/settings.local.json
